APP_NAME="Portal N.E.P. 30"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En la PC (Laragon/XAMPP): MySQL 8 local con root sin clave.
# En la VPS: nep30_app (nunca root). Ver docs/ENTORNO_DEMO.md
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_nep30
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# En local usar sync: los correos (recuperación y alta de contraseña) se envían al momento.
# En el VPS se usa database con el worker de Supervisor.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@nep30.test"
MAIL_FROM_NAME="${APP_NAME}"

# Para probar correos reales en local con Brevo (cada uno con su cuenta personal).
# La clave SMTP va solo en tu .env, nunca en este archivo ni en el repositorio.
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_usuario_smtp_de_brevo
# MAIL_PASSWORD=tu_clave_smtp_de_brevo
# MAIL_FROM_ADDRESS="tu_correo_verificado_en_brevo"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrador inicial (php artisan db:seed). En la PC, si se dejan vacíos,
# se usa admin@nep30.test / password. En la VPS y en producción son obligatorios.
ADMIN_DNI=
ADMIN_APELLIDO=
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# HU03: geocodificación con Nominatim (opcional; si se dejan comentadas se usan los valores de config/services.php)
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_USER_AGENT="PortalNEP30/1.0 (TFI UTN FRRe; portal de la N.E.P. y F.P. N.º 30, Formosa)"
