# .env del Portal N.E.P. 30 en la VPS de DEMOS (Azure).
# APP_ENV=demo: igual de seguro que producción, pero el seeder carga los datos
# de PRUEBA (DatosDePruebaSeeder). En el hosting de la institución va APP_ENV=demo.
# Se crea UNA vez en /var/www/portal-nep30/.env (nunca se sube al repositorio).
# Los valores entre < > se completan a mano.

APP_NAME="Portal N.E.P. 30"
APP_ENV=demo
APP_KEY=                      # lo completa: php artisan key:generate
APP_DEBUG=false               # NUNCA true en el servidor: mostraría claves y rutas
APP_URL=https://<dominio>
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_nep30
DB_USERNAME=nep30_app         # nunca root
DB_PASSWORD=<clave de nep30_app, en ~/LEEME_claves_nep30.txt>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true    # la cookie de sesión solo viaja por HTTPS

CACHE_STORE=database
QUEUE_CONNECTION=database     # los correos se envían en segundo plano (worker de Supervisor)
FILESYSTEM_DISK=local

# Brevo (cuenta de desarrollo del equipo hasta tener la de la institución)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<usuario SMTP de Brevo>
MAIL_PASSWORD=<clave SMTP de Brevo>
MAIL_FROM_ADDRESS=<correo verificado en Brevo>
MAIL_FROM_NAME="${APP_NAME}"

# Administrador inicial (php artisan db:seed). Obligatorio fuera de la PC.
# La clave: 12 caracteres o más. Después de sembrar se pueden borrar estas líneas.
ADMIN_DNI=<8 dígitos, inventado>
ADMIN_APELLIDO=<apellido>
ADMIN_NOMBRE=<nombre>
ADMIN_EMAIL=<correo>
ADMIN_PASSWORD=<clave larga>
