# Portal N.E.P. 30 - MySQL 8 ajustado a una VM de 4 GiB
[mysqld]
bind-address              = 127.0.0.1     # solo conexiones desde el mismo servidor
mysqlx                    = OFF
character-set-server      = utf8mb4
collation-server          = utf8mb4_unicode_ci
default-time-zone         = '-03:00'
sql_mode                  = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
innodb_buffer_pool_size   = 768M
max_connections           = 60
performance_schema        = OFF
# Un solo servidor: sin binlog. Así nep30_migraciones puede crear los triggers
# sin privilegio SUPER y no se llena el disco con registros binarios.
disable_log_bin
